# Copy this file to .env. Fill in the Claude token, or the fallback key, or both.
# With only the fallback key the project still runs: every call goes to the fallback.

# The token the `llm` service uses to sign in to Claude. Create one with:
#     claude setup-token
# Keep this file private: do not commit it or include it when sharing the project.
CLAUDE_CODE_OAUTH_TOKEN=

# Where LLM calls are sent: any server that accepts POST /v1/messages.
# The default is the `llm` service started by docker compose.
LLM_BASE_URL=http://llm:8787
# Sent as the x-api-key header. Leave empty if the server does not need one.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Backup model server (APIYI, https://api.apiyi.com). If the primary fails for any
# reason, the same request is sent here. Leave the URL empty to turn the fallback off.
LLM_FALLBACK_BASE_URL=https://api.apiyi.com
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=claude-opus-5-5

# tiny | base | small | medium | large-v3  (bigger is more accurate and slower on CPU)
WHISPER_MODEL=base

# hybrid | dense | keyword
RETRIEVAL_MODE=hybrid

# Percent of a video a learner must watch before an assessment is generated.
COMPLETION_THRESHOLD=80
QUESTIONS_PER_ASSESSMENT=8

LOG_LEVEL=INFO
